{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diwali-party",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // Run: npx wrangler kv namespace create RSVPS  -> paste the id below
    { "binding": "RSVPS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
