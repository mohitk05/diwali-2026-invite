{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diwali-party",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Static site in ./public. /api/* goes to the Worker; any other path is a static file.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api", "/api/*"]
  },
  "kv_namespaces": [
    { "binding": "RSVPS", "id": "f43c6d49553a41f1aca43649683cd29a" }
  ]
  // Secret (not in this file): ADMIN_TOKEN
  //   local: put it in .dev.vars   production: wrangler secret put ADMIN_TOKEN
}
